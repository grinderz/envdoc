{{- define "item" }}
  {{- $ := index . 0 }}
  {{- $cfg := index . 1 }}
  {{- if $.EnvName }}
| {{ $.EnvName }} | `{{ $.Type }}` | {{ $.Doc }} | {{ template "item.values" $ }}{{ template "item.options" (list $ $cfg (or (and (or $.Values $.Map) " (%s)") "(%s)")) }} |
  {{- end }}
  {{- range $child := $.Children }}
    {{- template "item" (list $child $cfg) }}
  {{- end }}
{{- end -}}

{{- define "item.values" }}
  {{- if $.Values }}one of: {{ range $i, $v := $.Values }}{{ if $i }}, {{ end }}`{{ $v }}`{{ end }}{{ end }}
  {{- if $.Map }}`key:value` pairs{{ end }}
{{- end -}}

{{- $cfg := $.Config -}}
# {{ .Title }}
{{ range .Sections -}}
{{ if .Name }}
## {{ .Name }}
{{ end }}
{{- if .Doc }}
{{ .Doc }}
{{ end }}
| env variable | type | description | options |
|--------------|------|-------------|---------|
{{- range $item := .Items }}
  {{- template "item" (list $item $cfg.Item) }}
{{- end }}
{{ end }}
